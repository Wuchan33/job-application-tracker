GEMINI_API_KEY=
# Free tier works with flash models. Pro models require billing enabled.
# Each model has its own requests-per-minute (RPM) limit; a lower limit
# may cause errors when classifying many emails at once.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite

POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker